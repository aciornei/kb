{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "NewPrometheus-Intranet",
      "description": "Select your existing Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Dedicated Redis HA alert dashboard using legacy panel alerts for Grafana 10.x; independent of Unified Alerting.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Redis Cluster HA | Legacy Alerting",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**3 VMs · 6 Redis instances · 3 masters · 3 replicas**  \nLegacy Alerting only. Every rule evaluates every 30s and confirms for 1m. All seven rules use the existing Rocket.Chat notification channel (UID: vudJ01p4k).  \nTargets: 172.20.10.80:7001/7002 · 172.20.10.81:7003/7004 · 172.20.10.82:7005/7006."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Masters per VM",
      "description": "Expected: one master per VM. Two or more on any VM triggers the alert. Missing masters are covered by Masters Count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (vm) (label_replace(max by (instance) (redis_up{job=\"redis_exporter_targets\",instance=~\"(redis://)?172[.]20[.]10[.](80:700[12]|81:700[34]|82:700[56])\",instance_role=\"master\"}), \"vm\", \"$2\", \"instance\", \"(redis://)?([^:]+):[0-9]+\")) or on (vm) label_replace(vector(0), \"vm\", \"172.20.10.80\", \"__name__\", \".*\") or on (vm) label_replace(vector(0), \"vm\", \"172.20.10.81\", \"__name__\", \".*\") or on (vm) label_replace(vector(0), \"vm\", \"172.20.10.82\", \"__name__\", \".*\")",
          "instant": false,
          "range": true,
          "legendFormat": "{{vm}}",
          "refId": "A"
        }
      ],
      "alert": {
        "alertRuleTags": {
          "severity": "critical",
          "service": "redis-cluster"
        },
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                1
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "1m",
        "frequency": "30s",
        "handler": 1,
        "message": "CRITICAL - Multiple Redis masters on the same VM. HA is degraded; rebalance master roles after checking replication.",
        "name": "Redis-Masters-Unbalanced",
        "noDataState": "alerting",
        "notifications": [
          {
            "uid": "vudJ01p4k"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "min": 0,
          "softMax": 3,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "alertThreshold": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cluster state",
      "description": "Expected: 1. Minimum across all reported cluster states; missing all metrics yields 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min(redis_cluster_state{job=\"redis_exporter_targets\",instance=~\"(redis://)?172[.]20[.]10[.](80:700[12]|81:700[34]|82:700[56])\"}) or vector(0)",
          "instant": false,
          "range": true,
          "legendFormat": "Cluster state",
          "refId": "A"
        }
      ],
      "alert": {
        "alertRuleTags": {
          "severity": "critical",
          "service": "redis-cluster"
        },
        "conditions": [
          {
            "evaluator": {
              "type": "lt",
              "params": [
                1
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "1m",
        "frequency": "30s",
        "handler": 1,
        "message": "CRITICAL - Redis cluster state is FAIL or no cluster state is available. Check quorum, slots and exporter connectivity.",
        "name": "Redis-Cluster-Down",
        "noDataState": "alerting",
        "notifications": [
          {
            "uid": "vudJ01p4k"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "min": 0,
          "softMax": 1,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
