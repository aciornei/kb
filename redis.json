  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "HA readiness (estimated)",
      "description": "Conservative metric-based estimate, not a guarantee of successful failover. Requires all six nodes and scrapes, healthy links, distinct parents, balanced masters and no colocated replica.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(redis_up{job=~\"$job\"}) or vector(0)) == bool 6) * ((sum(redis_up{job=~\"$job\",instance_role=\"master\"}) or vector(0)) == bool 3) * ((sum(redis_master_link_up{job=~\"$job\"}) or vector(0)) == bool 3) * ((count((sum by (vm) (label_replace(redis_up{job=~\"$job\",instance_role=\"master\"}, \"vm\", \"$1\", \"instance\", \"redis://([^:]+):[0-9]+\")) or (0 * sum by (vm) (label_replace(up{job=~\"$job\"}, \"vm\", \"$1\", \"instance\", \"redis://([^:]+):[0-9]+\")))) == 1) or vector(0)) == bool 3) * ((count((label_replace(redis_master_link_up{job=~\"$job\"}, \"vm\", \"$1\", \"instance\", \"redis://([^:]+):[0-9]+\")) and on(instance,vm) label_replace(redis_master_link_up{job=~\"$job\"}, \"vm\", \"$1\", \"master_host\", \"(.+)\")) or vector(0)) == bool 0) * ((count(count by(master_host,master_port) (redis_master_link_up{job=~\"$job\"} == 1)) or vector(0)) == bool 3) * ((min(redis_cluster_state{job=~\"$job\"}) or vector(0)) == bool 1) * ((sum(up{job=~\"$job\"}) or vector(0)) == bool 6)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT READY",
                  "color": "red"
                },
                "1": {
                  "text": "READY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
