  ],
  "id": null,
  "uid": "redis-cluster-ha-guard",
  "title": "Redis Cluster - High Availability",
  "tags": [
    "redis",
    "ha",
    "cluster"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
