Import-Module ActiveDirectory

Get-ADUser -Identity "username" `
    -Properties userPrincipalName,displayName,mail,whenChanged,msDS-PrincipalName |
    Select-Object `
        SamAccountName,
        UserPrincipalName,
        Name,
        DisplayName,
        Mail,
        DistinguishedName,
        ObjectGUID,
        SID,
        WhenChanged,
        @{Name="msDS-PrincipalName";Expression={$_.'msDS-PrincipalName'}} |
    Format-List


Get-ADUser -Identity "username" `
    -Server "dc01.domeniu.ro" `
    -Properties * |
    Format-List SamAccountName,UserPrincipalName,DisplayName,DistinguishedName,ObjectGUID,whenChanged,uSNChanged


Get-ADUser -Identity "username" `
    -Server "dc01.domeniu.ro" `
    -Properties * |
    Format-List *


$user = "username"

Get-ADDomainController -Filter * | ForEach-Object {
    $dc = $_.HostName

    try {
        $u = Get-ADUser -Identity $user `
            -Server $dc `
            -Properties UserPrincipalName

        [PSCustomObject]@{
            DC                = $dc
            SamAccountName    = $u.SamAccountName
            UserPrincipalName = $u.UserPrincipalName
        }
    }
    catch {
        Write-Warning "Nu pot interoga $dc : $_"
    }
} | Format-Table -AutoSize
