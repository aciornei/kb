/opt/keycloak/bin/kcadm.sh create components -r AD \
  -s "name=Kerberos principal attribute mapper" \
  -s "providerId=kerberos-principal-attribute-mapper" \
  -s "providerType=org.keycloak.storage.ldap.mappers.LDAPStorageMapper" \
  -s "parentId=$LDAP_ID"

/opt/keycloak/bin/kcadm.sh get components -r AD \
  -q "parent=$LDAP_ID" |
jq -r '.[] |
  select(.providerId == "kerberos-principal-attribute-mapper") |
  [.id, .name, .providerId] | @tsv'


/opt/keycloak/bin/kcadm.sh create \
  "user-storage/$LDAP_ID/sync?action=triggerFullSync" \
  -r AD
