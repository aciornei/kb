SELECT
    u.username,
    ua.value AS kerberos_principal,
    CONCAT(u.username, '@sts.nest') AS principal_estimat
FROM user_entity u
JOIN user_attribute ua ON ua.user_id = u.id
JOIN realm r ON r.id = u.realm_id
WHERE r.name = 'AD'
  AND u.enabled = 1
  AND ua.name = 'KERBEROS_PRINCIPAL'
  AND LOWER(ua.value) <>
      LOWER(CONCAT(u.username, '@sts.nest'))
ORDER BY u.username;
