                "expr": "min(redis_cluster_state{job=\"redis_exporter_targets\"} and on(instance,job) (redis_up{job=\"redis_exporter_targets\"} == 1))",
                "instant": true,
                "range": false,
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "type": "threshold",
                "refId": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ],
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "1m",
          "annotations": {
            "summary": "RedisClusterDown",
            "description": "At least one reachable Redis node reports cluster failure.",
            "__dashboardUid__": "redis-cluster-ha-guard",
            "__panelId__": "3"
          },
          "labels": {
            "service": "redis",
            "severity": "critical",
